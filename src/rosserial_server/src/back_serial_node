
#include <boost/asio.hpp>
#include <rclcpp/rclcpp.hpp>

namespace ros2_serial{

class SerialNode :public rclcpp::Node {

public: 
    SerialNode(std::string port = "/dev/ttyUSB0", int baud = 115200,std::string node_name="serial_node") : Node (node_name){
        port_ = this->declare_parameter("port",port);
        baud_= this->declare_parameter("baud",baud);
        callback_handle_ = this->add_on_set_parameters_callback(std::bind(&SerialNode::parameter_callback, this, std::placeholders::_1));
        open_serial(baud_);
        
    }

private:
    std::string port_ ;
    int baud_;
    boost::asio::io_context service_io_;
    boost::asio::serial_port serial_{service_io_};
    rclcpp::node_interfaces::OnSetParametersCallbackHandle::SharedPtr callback_handle_;
    int failed_connection_attempts_{0};
    int failed_close_attempts_{0};


    rcl_interfaces::msg::SetParametersResult parameter_callback(const std::vector<rclcpp::Parameter>& params)
    {
        rcl_interfaces::msg::SetParametersResult result;
        result.successful = true;
        result.reason = "success";
        for (const auto &param : params)
        {
            if (param.get_name() == "baud")
            {
                int new_baud = param.as_int();
                if (new_baud <= 0)
                {
                    result.successful = false;
                    result.reason = "The baud value is wrong !";
                    return result;
                }
                RCLCPP_WARN (this->get_logger(),"检测到修改波特率请求：%d -> %d",this->baud_, new_baud);
            //修改波特率相关实现
            if(reload_hardwre(new_baud))
            {
                this->baud_ = new_baud;
            }
            else{
                result.successful = false;
                result.reason = "Setting buad failed";
            }
            return result;
            }

            if (param.get_name() == "port"){
                std::string old_port = this->port_;
                std::string new_port  = param.as_string();
                if(new_port == ""){
                    result.successful = false;
                    result.reason = "The port name is null !";
                    return result;
                }
                RCLCPP_WARN(this->get_logger(), "检测到修改端口名请求：%s -> %s", this->port_.c_str(), new_port.c_str());
                boost::system::error_code ec;
                this->serial_.close(ec);
                this->port_ = new_port;
                if(!open_serial(this->baud_)){
                    this->port_ = old_port;
                    result.successful = false;
                    result.reason = "Setting port failed";
                }
                return result;
            }
        } 
        return result;
    }

    bool open_serial(const int& baud)
    {
        boost::system::error_code ec;
        if (this->serial_.is_open())
            this->serial_.close(ec);
        serial_.open(this->port_, ec);
        if (ec)
        {
            failed_connection_attempts_++;
          if(failed_connection_attempts_== 1)
          {
            RCLCPP_ERROR_STREAM(this->get_logger(), "Unable to open port"<<this->port_<<":"<<ec);
          }  
          else
          {
            RCLCPP_WARN_STREAM(this->get_logger(), "Unable to open port"<<this->port_<<":"<<ec);
          }
          return false;
        }
        RCLCPP_DEBUG_STREAM(this->get_logger(),"Open"<<":"<<this->port_);
        failed_connection_attempts_ = 0;
        this->serial_.set_option(boost::asio::serial_port_base::baud_rate(baud));
        this->serial_.set_option(boost::asio::serial_port_base::character_size(8));
        this->serial_.set_option(boost::asio::serial_port_base::stop_bits(boost::asio::serial_port_base::stop_bits::one));
        this->serial_.set_option(boost::asio::serial_port_base::parity(boost::asio::serial_port_base::parity::none));
        this->serial_.set_option(boost::asio::serial_port_base::flow_control(boost::asio::serial_port_base::flow_control::none));
        return true;
    }   

    bool reload_hardwre(const int& new_baud)
    {
        boost::system::error_code ec;
        this->serial_.close(ec);
        if (ec)
        {
            failed_close_attempts_++;
          if(failed_close_attempts_== 1)
          {
            RCLCPP_ERROR_STREAM(this->get_logger(), "Unable to close port"<<this->port_<<":"<<ec);
          }  
          else
          {
            RCLCPP_WARN_STREAM(this->get_logger(), "Unable to close port"<<this->port_<<":"<<ec);
          }
          return false;
        }
        RCLCPP_DEBUG_STREAM(this->get_logger(),"Open"<<":"<<this->port_);
        failed_close_attempts_ = 0;
        return (open_serial(new_baud));
    }


};
}

int main(int argc, char** argv)
{
    rclcpp::init(argc, argv);
    auto node = std::make_shared<ros2_serial::SerialNode>();

    rclcpp::spin(node);
    rclcpp::shutdown();

    return 0;
}

